+		}
+		if (time_before(jiffies, battmgr->host_verify_after)) {
+			delay = battmgr->host_verify_after - jiffies;
+		} else {
+			ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						 BATT_CURR_NOW);
+			if (ret)
