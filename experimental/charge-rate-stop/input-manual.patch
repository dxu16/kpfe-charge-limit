+static int qcom_battmgr_set_oem_charge_behaviour(struct qcom_battmgr *battmgr,
+					       int behaviour)
+{
+	union power_supply_propval charge_state;
+	bool changed = false;
+	int ret;
+
+	if (!battmgr->oem_bypass_supported)
+		return -EOPNOTSUPP;
+	if (behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+	    behaviour != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)
+		return -EINVAL;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_get_oem_charge_behaviour(battmgr, &charge_state);
+	if (ret || charge_state.intval == behaviour)
+		goto out;
+
+	/* Mixing the two mechanisms would leave the faulty native policy active. */
+	if (behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						    BATT_CHG_CTRL_EN, 0);
+		if (ret)
+			goto out;
+		if (battmgr->native_charge_limit_enabled) {
+			ret = -EBUSY;
+			goto out;
+		}
+	}
+
+	/* Repeated entry can overwrite firmware's saved charge-current setting. */
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_SET,
+					    BATT_OEM_CHARGE_ONLINE,
+					    behaviour == POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO);
+	if (!ret) {
+		ret = qcom_battmgr_get_oem_charge_behaviour(battmgr, &charge_state);
+		if (!ret && charge_state.intval != behaviour)
+			ret = -EIO;
+		changed = !ret;
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	if (changed)
+		power_supply_changed(battmgr->bat_psy);
+	return ret > 0 ? -EIO : ret;
+}
