+/* Caller holds lock; read firmware state before every possible transition. */
+static int qcom_battmgr_get_oem_charge_behaviour(struct qcom_battmgr *battmgr,
+					       union power_supply_propval *val)
+{
+	int ret;
+
+	if (!battmgr->oem_bypass_supported)
+		return -EOPNOTSUPP;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					    BATT_OEM_CHARGE_ONLINE, 0);
+	if (ret)
+		return ret < 0 ? ret : -EIO;
+
+	val->intval = battmgr->oem_charge_online ? POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+	return 0;
+}
