+static void qcom_battmgr_charge_rate_ack(struct qcom_battmgr *battmgr,
+					const void *data, size_t len)
+{
+	const struct {
+		struct pmic_glink_hdr hdr;
+		__le32 result;
+	} *response = data;
+
+	if (len != sizeof(*response))
+		battmgr->error = -ENODATA;
+	else
+		battmgr->error = le32_to_cpu(response->result) ? -EIO : 0;
+	complete(&battmgr->ack);
+}
