+	props[base->num_properties] = POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR;
+	desc->properties = props;
+	desc->num_properties++;
+	desc->charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+		BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
