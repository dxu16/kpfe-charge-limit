+/* A short cable bounce cannot start another negotiation window. */
+static void qcom_battmgr_host_pd_connection(struct qcom_battmgr *battmgr, int epoch)
+{
+	if (battmgr->host_pd_epoch != epoch) {
+		battmgr->host_pd_epoch = epoch;
+		battmgr->host_pd_pending = false;
+		battmgr->host_pd_offline_seen = false;
+	}
+
+	if (!battmgr->usb.online) {
+		if (!battmgr->host_pd_offline_seen)
+			battmgr->host_pd_offline_at = jiffies;
+		battmgr->host_pd_offline_seen = true;
+		battmgr->host_pd_online = false;
+		battmgr->host_pd_pending = false;
+	} else if (!battmgr->host_pd_online) {
+		battmgr->host_pd_pending = !battmgr->host_pd_suspended &&
+			battmgr->host_pd_offline_seen &&
+			time_after_eq(jiffies, battmgr->host_pd_offline_at + HZ);
+		battmgr->host_pd_check_until = jiffies + 4 * HZ;
+		battmgr->host_pd_online = true;
+		battmgr->host_pd_offline_seen = false;
+	}
+}
+
+static int qcom_battmgr_host_pd_source(void)
+{
+	union power_supply_propval type, maximum;
+	struct power_supply *psy;
+	int ret;
+
+	/* KPFE has one USB-C port on the PMIC GLINK UCSI instance. */
+	psy = power_supply_get_by_name("ucsi-source-psy-pmic_glink.ucsi.01");
+	if (!psy)
+		return -EAGAIN;
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &type);
+	if (!ret && !type.intval)
+		ret = -EAGAIN;
+	if (!ret)
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_USB_TYPE, &type);
+	if (!ret && type.intval != POWER_SUPPLY_USB_TYPE_PD &&
+	    type.intval != POWER_SUPPLY_USB_TYPE_PD_PPS)
+		ret = -EAGAIN;
+	if (!ret)
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_MAX,
+						&maximum);
+	power_supply_put(psy);
+	if (ret)
+		return ret;
+	/* Some firmware confirms PD but does not export the source PDOs. */
+	return !maximum.intval || maximum.intval >= 9000000;
+}
+
+static int qcom_battmgr_host_pd_reapply_stop(struct qcom_battmgr *battmgr, int epoch)
+{
+	int ret;
+
+	ret = qcom_battmgr_host_set_rate(battmgr, true, epoch);
+	/*
+	 * A failed release may still reply while we wait for the stop.
+	 * Require two successful replies in that case: at most one can
+	 * be for the release, and every subsequent request is a stop.
+	 */
+	if (!ret && battmgr->host_pd_confirm_twice) {
+		battmgr->host_pd_confirm_twice = false;
+		battmgr->host_rate_valid = false;
+		ret = -EAGAIN;
+	}
+	if (!ret) {
+		battmgr->host_pd_restop = false;
+	} else if (READ_ONCE(battmgr->service_up)) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+	}
+	return ret;
+}
+
+/* Called with the request mutex held after the battery stop has been applied. */
+static int qcom_battmgr_host_pd_upgrade(struct qcom_battmgr *battmgr, int epoch)
+{
+	unsigned long deadline;
+	int ret, high_samples = 0;
+
+	if (!battmgr->host_pd_pending || battmgr->host_pd_suspended)
+		return 0;
+	if (battmgr->host_pd_rate_error_epoch == epoch ||
+	    time_after_eq(jiffies, battmgr->host_pd_check_until)) {
+		battmgr->host_pd_pending = false;
+		return 0;
+	}
+	ret = qcom_battmgr_host_pd_source();
+	if (ret == -EAGAIN) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+		return 0;
+	}
+	if (ret <= 0) {
+		battmgr->host_pd_pending = false;
+		return 0;
+	}
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_MAX);
+	if (!ret && !battmgr->usb.voltage_max) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+		return 0;
+	}
+	battmgr->host_pd_pending = false;
+	if (ret || battmgr->usb.voltage_max != 5000000)
+		return ret;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH);
+	if (ret || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD)
+		return ret;
+
+	pm_wakeup_event(battmgr->dev, 6000);
+	deadline = jiffies + msecs_to_jiffies(2500);
+	/* Even a timed-out release may have reached firmware. Always send stop. */
+	battmgr->host_pd_restop = true;
+	ret = qcom_battmgr_host_set_rate(battmgr, false, epoch);
+	battmgr->host_pd_confirm_twice = !!ret;
+	while (!ret && time_before(jiffies, deadline)) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+		if (ret || !battmgr->usb.online || epoch != atomic_read(&battmgr->host_epoch) ||
+		    time_after_eq(jiffies, deadline))
+			break;
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_NOW);
+		if (ret)
+			break;
+		if (battmgr->usb.voltage_now >= 8000000) {
+			if (++high_samples == 2)
+				break;
+		} else {
+			high_samples = 0;
+		}
+		msleep(100);
+	}
+	ret = qcom_battmgr_host_pd_reapply_stop(battmgr, epoch);
+	if (!ret)
+		dev_info(battmgr->dev, "USB-PD reconnect: %s; battery stop restored\n",
+			 high_samples == 2 ? "higher voltage observed" : "no higher voltage observed");
+	return ret;
+}
