+static int qcom_battmgr_pd_suspend_prepare(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!battmgr || !battmgr->host_charge_limit)
+		return 0;
+	mutex_lock(&battmgr->lock);
+	if (battmgr->host_pd_restop) {
+		ret = -EBUSY;
+	} else {
+		battmgr->host_pd_suspended = true;
+		battmgr->host_pd_pending = false;
+	}
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+
+static void qcom_battmgr_pd_suspend_complete(struct device *dev)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+
+	if (!battmgr || !battmgr->host_charge_limit)
+		return;
+	mutex_lock(&battmgr->lock);
+	/* An attachment whose timing is uncertain must not open a window. */
+	battmgr->host_pd_offline_seen = false;
+	battmgr->host_pd_suspended = false;
+	mutex_unlock(&battmgr->lock);
+}
+
+static const struct dev_pm_ops qcom_battmgr_pd_pm_ops = {
+	.prepare = qcom_battmgr_pd_suspend_prepare,
+	.complete = qcom_battmgr_pd_suspend_complete,
+};
